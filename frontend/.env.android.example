# Copy to frontend/.env.android.local (never committed). Used by `npm run build:android`
# on top of .env.local, so the Firebase web config there still applies.

# The Android app has no /api proxy: this must be an absolute URL.
# For now: your PC's LAN IP running the backend (phone and PC on the same Wi-Fi),
# e.g. http://192.168.1.20:8000. After deploying: https://arth-solo-2026.web.app/api
# The backend's ARTH_CORS_ORIGINS must include https://localhost (the app's origin).
VITE_API_BASE_URL=
