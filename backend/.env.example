# Copy to backend/.env and fill in. Never commit .env.
ARTH_ENV=development
PORT=8000

# Firebase project ID (Firebase console -> Project settings). Public, not a secret.
ARTH_FIREBASE_PROJECT_ID=

# Browser origins allowed to call the API (comma-separated).
ARTH_CORS_ORIGINS=http://localhost:5173

# Data store: memory (local dev, lost on restart) | firestore (Google Cloud)
ARTH_STORE=memory

# Gemini API key from https://aistudio.google.com/apikey (on Cloud Run: Secret Manager).
GEMINI_API_KEY=
# Gemma 4 on the Gemini API for photos: gemma-4-26b-a4b-it (fast) or gemma-4-31b-it.
ARTH_MODEL=gemma-4-26b-a4b-it
# Voice needs audio input, which hosted Gemma 4 does not list; a Gemini model handles it.
ARTH_AUDIO_MODEL=gemini-2.5-flash
# District farm news: a Gemini model with Google Search grounding.
ARTH_NEWS_MODEL=gemini-2.5-flash

# Google sign-in emails that may open the founder dashboard (comma-separated, verified emails only).
ARTH_ADMIN_EMAILS=

# Free key from https://data.gov.in for live mandi prices.
ARTH_DATA_GOV_IN_API_KEY=
# Rough truck cost used in sell advice, ₹ per quintal per km.
ARTH_TRANSPORT_RS_PER_QUINTAL_KM=2

# Only off Google Cloud (e.g. Vercel): the Firebase service account key JSON, or base64 of it.
ARTH_FIREBASE_SERVICE_ACCOUNT=
