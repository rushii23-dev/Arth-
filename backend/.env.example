# Copy to backend/.env and fill in. Never commit .env.
ARTH_ENV=development
PORT=8000

# Firebase project ID (Firebase console -> Project settings). Public, not a secret.
ARTH_FIREBASE_PROJECT_ID=

# Browser origins allowed to call the API (comma-separated).
ARTH_CORS_ORIGINS=http://localhost:5173

# Data store: memory (local dev, lost on restart) | firestore (Google Cloud)
ARTH_STORE=memory

# Gemini API key from https://aistudio.google.com/apikey (on Cloud Run: Secret Manager).
GEMINI_API_KEY=
# Gemma 4 model id on the Gemini API (set when the AI routes are built).
ARTH_MODEL=

# Free key from https://data.gov.in for live mandi prices.
ARTH_DATA_GOV_IN_API_KEY=
